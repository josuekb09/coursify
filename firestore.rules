rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─── Helpers ───────────────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isFounder() {
      return signedIn() && request.auth.token.email == 'kabuyatambwe03@gmail.com';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function changed() {
      return incoming().diff(existing()).affectedKeys();
    }

    // Optional string field: absent, or a string no longer than max.
    function optString(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    function reqString(data, key, min, max) {
      return key in data && data[key] is string && data[key].size() >= min && data[key].size() <= max;
    }

    function optBool(data, key) {
      return !(key in data) || data[key] is bool;
    }

    function optNumber(data, key) {
      return !(key in data) || data[key] is number;
    }

    // Only teachers whose SACE registration the founder confirmed may publish.
    function verifiedTeacher() {
      return isFounder()
        || get(/databases/$(database)/documents/educators/$(request.auth.uid)).data.get('verified', false) == true;
    }

    // ─── Public metadata ─────────────────────────────────────────────────────────────

    match /meta/{document} {
      allow read: if true;
      allow write: if isFounder();
      // Sign-up bumps the account counter by exactly one; nothing else.
      allow update: if signedIn() && document == 'stats'
        && changed().hasOnly(['users', 'hasAccounts'])
        && incoming().users == existing().get('users', 0) + 1
        && incoming().get('hasAccounts', true) == true;
      allow create: if signedIn() && document == 'stats'
        && incoming().keys().hasOnly(['users', 'hasAccounts'])
        && incoming().users == 1;
    }

    // ─── Private account data (email) — only the owner and the founder can read it ──

    match /accounts/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isFounder());
      allow create, update: if signedIn() && request.auth.uid == userId
        && incoming().keys().hasOnly(['email', 'updatedAt', 'acceptedTermsAt', 'acceptedTermsVersion'])
        && incoming().email == request.auth.token.email
        && optString(incoming(), 'updatedAt', 40)
        && optString(incoming(), 'acceptedTermsAt', 40)
        && optString(incoming(), 'acceptedTermsVersion', 20);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // ─── Teacher verification requests (SACE number), reviewed by the founder ─────────

    match /verificationRequests/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isFounder());
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && incoming().keys().hasOnly(['saceNumber', 'school', 'name', 'status', 'submittedAt'])
        && incoming().status == 'pending'
        && incoming().saceNumber is string && incoming().saceNumber.matches('[0-9]{5,12}')
        && reqString(incoming(), 'school', 3, 120)
        && optString(incoming(), 'name', 80)
        && optString(incoming(), 'submittedAt', 40);
      allow update: if isFounder()
        && changed().hasOnly(['status', 'reviewedAt', 'note'])
        && incoming().status in ['approved', 'rejected']
        && optString(incoming(), 'note', 300);
      allow delete: if signedIn() && (request.auth.uid == userId || isFounder());
    }

    // ─── Public educator profiles ─────────────────────────────────────────────────────

    function educatorKeys() {
      return [
        'email', 'name', 'initials', 'school', 'subject', 'bio', 'joinedYear', 'storageBytes',
        'verified', 'badgeClaimed', 'badgeClaimedAt', 'badgeEvidence', 'founder',
        'institutionLevel', 'photoData', 'lastActiveAt', 'createdAt', 'updatedAt'
      ];
    }

    // Field shapes. Key whitelists are applied to new documents and to the keys a write changes,
    // so older documents with retired fields stay editable.
    function validEducator(data) {
      // Legacy profiles may still carry the owner's own email; nobody else's is ever accepted.
      return (!('email' in data) || data.email == request.auth.token.email || isFounder())
        && optString(data, 'name', 80)
        && optString(data, 'initials', 4)
        && optString(data, 'school', 120)
        && optString(data, 'subject', 80)
        && optString(data, 'bio', 800)
        && optNumber(data, 'joinedYear')
        && optNumber(data, 'storageBytes')
        && optBool(data, 'verified')
        && optBool(data, 'badgeClaimed')
        && optString(data, 'badgeClaimedAt', 40)
        && (!('institutionLevel' in data) || data.institutionLevel in ['high-school', 'university'])
        && optString(data, 'photoData', 700000)
        && optString(data, 'lastActiveAt', 40)
        && optString(data, 'createdAt', 40)
        && optString(data, 'updatedAt', 40)
        && (!('founder' in data) || data.founder == false || isFounder());
    }

    match /educators/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
        && incoming().keys().hasOnly(educatorKeys())
        && !('email' in incoming())
        && reqString(incoming(), 'name', 1, 80)
        && validEducator(incoming())
        && (incoming().get('verified', false) == false || isFounder())
        && (incoming().get('badgeClaimed', false) == false || isFounder());
      allow update: if signedIn() && (
        isFounder()
        || (
          request.auth.uid == userId
          && changed().hasOnly(educatorKeys())
          && validEducator(incoming())
          && (
            (
              incoming().get('verified', false) == existing().get('verified', false)
              && incoming().get('badgeClaimed', false) == existing().get('badgeClaimed', false)
              && !changed().hasAny(['badgeEvidence', 'badgeClaimedAt'])
            )
          )
        )
      );
      allow delete: if signedIn() && (request.auth.uid == userId || isFounder());
    }

    // ─── Resources ─────────────────────────────────────────────────────────────────

    function resourceKeys() {
      return [
        'title', 'authorId', 'subject', 'grade', 'kind', 'format', 'mimeType', 'type',
        'downloads', 'saves', 'fileName', 'fileSize', 'fileBytes', 'fileData', 'fileUrl',
        'storagePath', 'localOnly', 'slides', 'hasFile', 'sourceUrl', 'createdAt', 'updatedAt'
      ];
    }

    function validResource(data) {
      return reqString(data, 'title', 1, 200)
        && optString(data, 'subject', 80)
        && optString(data, 'grade', 40)
        && optString(data, 'kind', 20)
        && optString(data, 'format', 20)
        && optString(data, 'mimeType', 120)
        && optString(data, 'type', 60)
        && optString(data, 'fileName', 200)
        && optString(data, 'fileSize', 20)
        && optNumber(data, 'fileBytes')
        && optString(data, 'fileData', 900000)
        && optString(data, 'fileUrl', 2000)
        && optString(data, 'storagePath', 400)
        && optBool(data, 'localOnly')
        && optBool(data, 'hasFile')
        && optString(data, 'sourceUrl', 500)
        && optString(data, 'createdAt', 40)
        && (!('slides' in data) || (data.slides is list && data.slides.size() <= 200));
    }

    match /resources/{resourceId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && incoming().authorId == request.auth.uid
        && verifiedTeacher()
        && incoming().keys().hasOnly(resourceKeys())
        && validResource(incoming())
        && incoming().get('downloads', 0) == 0
        && incoming().get('saves', 0) == 0;
      allow update: if signedIn() && (
        (
          existing().authorId == request.auth.uid
          && incoming().authorId == existing().authorId
          && changed().hasOnly(resourceKeys())
          && validResource(incoming())
          && !changed().hasAny(['downloads', 'saves'])
        )
        // Anyone may count a download: exactly +1.
        || (
          changed().hasOnly(['downloads'])
          && incoming().downloads == existing().get('downloads', 0) + 1
        )
        // Saves move by one, and only alongside the caller's own save marker.
        || (
          changed().hasOnly(['saves'])
          && (
            (
              incoming().saves == existing().get('saves', 0) + 1
              && exists(/databases/$(database)/documents/saves/$(request.auth.uid + '_' + resourceId))
            )
            || (
              incoming().saves == existing().get('saves', 0) - 1
              && incoming().saves >= 0
              && !exists(/databases/$(database)/documents/saves/$(request.auth.uid + '_' + resourceId))
            )
          )
        )
      );
      allow delete: if signedIn() && (existing().authorId == request.auth.uid || isFounder());
    }

    // ─── Feed posts ──────────────────────────────────────────────────────────────────

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && incoming().authorId == request.auth.uid
        && incoming().keys().hasOnly(['authorId', 'body', 'resourceId', 'createdAt'])
        && reqString(incoming(), 'body', 1, 1000)
        && optString(incoming(), 'resourceId', 120)
        && optString(incoming(), 'createdAt', 40);
      allow delete: if signedIn() && (existing().authorId == request.auth.uid || isFounder());
    }

    // ─── Follows and saves (document id encodes the owner) ───────────────────────────

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && incoming().followerId == request.auth.uid
        && incoming().followeeId is string
        && incoming().followeeId != request.auth.uid
        && followId == request.auth.uid + '_' + incoming().followeeId
        && incoming().keys().hasOnly(['followerId', 'followeeId', 'createdAt']);
      allow delete: if signedIn() && (
        existing().followerId == request.auth.uid ||
        existing().followeeId == request.auth.uid
      );
    }

    match /saves/{saveId} {
      allow read: if signedIn() && existing().userId == request.auth.uid;
      allow create: if signedIn()
        && incoming().userId == request.auth.uid
        && incoming().resourceId is string
        && saveId == request.auth.uid + '_' + incoming().resourceId
        && incoming().keys().hasOnly(['userId', 'resourceId', 'createdAt']);
      allow delete: if signedIn() && existing().userId == request.auth.uid;
    }

    // ─── Private messaging ───────────────────────────────────────────────────────────

    function validPair(ids, conversationId) {
      return ids is list && ids.size() == 2
        && request.auth.uid in ids
        && ids[0] < ids[1]
        && conversationId == ids[0] + ':' + ids[1];
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in existing().participantIds;
      allow create: if signedIn()
        && validPair(incoming().participantIds, conversationId)
        && incoming().keys().hasOnly(['participantIds', 'updatedAt', 'lastMessage', 'lastReadAt', 'typingAt'])
        && optString(incoming(), 'lastMessage', 500);
      allow update: if signedIn()
        && request.auth.uid in existing().participantIds
        && incoming().participantIds == existing().participantIds
        && changed().hasOnly(['updatedAt', 'lastMessage', 'lastReadAt', 'typingAt'])
        && optString(incoming(), 'lastMessage', 500);
      allow delete: if signedIn() && request.auth.uid in existing().participantIds;
    }

    match /messages/{messageId} {
      allow read: if signedIn() && request.auth.uid in existing().participantIds;
      allow create: if signedIn()
        && incoming().senderId == request.auth.uid
        && incoming().conversationId is string
        && validPair(incoming().participantIds, incoming().conversationId)
        && incoming().keys().hasOnly([
          'conversationId', 'senderId', 'body', 'createdAt', 'participantIds',
          'attachmentUrl', 'attachmentName', 'attachmentType', 'attachmentSize'
        ])
        && optString(incoming(), 'body', 5000)
        && optString(incoming(), 'createdAt', 40)
        && optString(incoming(), 'attachmentUrl', 950000)
        && optString(incoming(), 'attachmentName', 200)
        && optString(incoming(), 'attachmentType', 120)
        && optString(incoming(), 'attachmentSize', 30);
      // People can only take back their own words.
      allow delete: if signedIn() && existing().senderId == request.auth.uid;
    }

    // ─── Meetups ─────────────────────────────────────────────────────────────────────

    function eventKeys() {
      return [
        'title', 'description', 'hostId', 'format', 'startsAt', 'location', 'meetingUrl',
        'rsvpIds', 'createdAt', 'updatedAt'
      ];
    }

    function validEvent(data) {
      return reqString(data, 'title', 1, 160)
        && optString(data, 'description', 2000)
        && data.format in ['in-person', 'online']
        && optString(data, 'startsAt', 40)
        && optString(data, 'location', 240)
        && optString(data, 'meetingUrl', 500)
        && data.rsvpIds is list && data.rsvpIds.size() <= 1000;
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && incoming().hostId == request.auth.uid
        && verifiedTeacher()
        && incoming().keys().hasOnly(eventKeys())
        && validEvent(incoming())
        && incoming().rsvpIds == [request.auth.uid];
      allow update: if signedIn() && (
        (
          existing().hostId == request.auth.uid
          && incoming().hostId == existing().hostId
          && changed().hasOnly(eventKeys())
          && validEvent(incoming())
        )
        // Guests can add or remove themselves, and nobody else.
        || (
          changed().hasOnly(['rsvpIds'])
          && incoming().rsvpIds is list
          && (
            (
              incoming().rsvpIds.toSet().difference(existing().rsvpIds.toSet()) == [request.auth.uid].toSet()
              && existing().rsvpIds.toSet().difference(incoming().rsvpIds.toSet()).size() == 0
            )
            || (
              existing().rsvpIds.toSet().difference(incoming().rsvpIds.toSet()) == [request.auth.uid].toSet()
              && incoming().rsvpIds.toSet().difference(existing().rsvpIds.toSet()).size() == 0
            )
          )
        )
      );
      allow delete: if signedIn() && (existing().hostId == request.auth.uid || isFounder());
    }
  }
}
