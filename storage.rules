rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // Types a browser would run as a page or script if opened directly.
    function activeContent() {
      return request.resource.contentType.matches('(?i)(text/html|application/xhtml\\+xml|image/svg\\+xml|text/javascript|application/javascript|application/x-javascript)(;.*)?');
    }

    match /avatars/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpe?g|webp|gif|avif)');
    }

    match /resources/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.size <= 50 * 1024 * 1024
        && !activeContent();
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
