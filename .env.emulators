# Local development against the Firebase emulators (npm run dev:emulators). No real keys here.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo
VITE_FIREBASE_AUTH_DOMAIN=demo-coursify.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-coursify
VITE_FIREBASE_STORAGE_BUCKET=demo-coursify.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo
